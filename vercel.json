{
  "version": 2,
  "buildCommand": "NODE_ENV=development npm install && npm run build",
  "outputDirectory": "out",
  "framework": null,
  "installCommand": "NODE_ENV=development npm install",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1.html" },
    { "src": "/(.*)/", "status": 301, "headers": { "Location": "/$1" } }
  ]
}
